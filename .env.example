# ═══════════════════════════════════════════════════════════════════════
#  Options Bot — environment variables
#
#  Copy to `.env` locally OR set in Railway Variables. Anything left
#  commented uses the default from server.py. Required vars are flagged.
# ═══════════════════════════════════════════════════════════════════════

# ─── REQUIRED — Kite Connect credentials ─────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# ─── REQUIRED — webhook auth ─────────────────────────────────────────
# Any non-empty string. Pine sends this in the JSON body (or X-Auth-Secret
# header). If unset, every endpoint REJECTS — fail-closed by design.
WEBHOOK_SECRET=

# ─── Persistence paths (mount a Railway volume at DATA_DIR) ──────────
DATA_DIR=/app/data
ACTIVE_TRADES_FILE=/app/data/active_trades.json
STREAK_FILE=/app/data/streak_state.json
ACCESS_TOKEN_PATH=/app/data/kite_access_token.txt

# ─── Order product ───────────────────────────────────────────────────
# NRML = overnight carry allowed.  MIS = intraday only (auto-squareoff at 3:15).
KITE_PRODUCT=NRML

# ─── Ladder (server-owned exits) — all % on SPOT, not premium ────────
# SL_PCT     : initial stop, distance from spot_at_entry
# TP_STEP_PCT: rung spacing for partial books + trailing
# BOOK_PCT   : % of ORIGINAL lots to sell at each rung
# MAX_BOOKS  : number of partial books before pure-trail mode
EXIT_POLL_SEC=10
SL_PCT=3.0
TP_STEP_PCT=4.0
BOOK_PCT=33.0
MAX_BOOKS=2
LADDER_VERBOSE=false

# ─── Per-position premium SL backstop ────────────────────────────────
# If option premium drops this much below entry, force-close that position.
# Independent of the spot-based ladder — catches IV crush / gap-down cases.
PREMIUM_SL_PCT=50.0

# ─── Combined PnL locks (on PREMIUM PnL across all open positions) ──
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_PCT=30.0
PROFIT_LOCK_COOLDOWN_SEC=1800

LOSS_LOCK_ENABLED=true
LOSS_LOCK_PCT=25.0
LOSS_LOCK_COOLDOWN_SEC=1800

# ─── Daily cap — cumulative profit-locked %, resets at IST midnight ──
DAILY_CAP_ENABLED=true
DAILY_CAP_PCT=50.0

# ─── Streak pause — N consecutive profit locks → pause for N seconds ─
STREAK_PAUSE_ENABLED=true
STREAK_PAUSE_COUNT=3
STREAK_PAUSE_SEC=3600

# ─── Per-symbol SL lockout (after a ladder SL fires on a symbol) ─────
SL_LOCKOUT_ENABLED=true
SL_LOCKOUT_SEC=600

# ─── Position cap — hard ceiling on concurrent symbols ───────────────
# 0 = unlimited. Default 5 — paired with 20% equity sizing means up to ~5
# concurrent positions before sizing math returns 0 lots and rejects.
MAX_POSITIONS=5

# ─── Sizing ──────────────────────────────────────────────────────────
# % of *currently available* equity per trade (recalculated each entry).
EQUITY_PCT_PER_TRADE=20.0
NUM_LOTS_MIN=1
NUM_LOTS_MAX=100

# ─── Option contract selection ───────────────────────────────────────
# EXPIRY_SAFETY_DAYS: refuse contracts within N days of expiry (1 = avoid
#   expiry day; non-negotiable for stock options because of physical settlement).
# STRIKE_OFFSET: 0 = ITM-by-one (default; CE just below spot, PE just above).
#   Positive shifts toward OTM; negative shifts deeper ITM.
EXPIRY_SAFETY_DAYS=1
STRIKE_OFFSET=0
