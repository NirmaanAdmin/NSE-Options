# ═══════════════════════════════════════════════════════════════════════
#  Zerodha options server — environment variables (Railway → Variables)
#  Anything commented out uses the default in server.py.
# ═══════════════════════════════════════════════════════════════════════

# ─── REQUIRED — Kite Connect ─────────────────────────────────────────
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# ─── REQUIRED — webhook auth (fail-closed if empty) ──────────────────
WEBHOOK_SECRET=

# ─── REQUIRED ON RAILWAY — static-IP egress (SEBI, enforced 1 Apr 2026) ─
# Zerodha rejects orders from IPs not registered on the Kite Connect app.
# Railway's outbound IP is dynamic → route Kite traffic through a static-IP
# proxy and register THAT IP on developers.kite.trade. Check the IP Kite
# sees with:  GET /egress-ip?secret=<WEBHOOK_SECRET>
# Format: http://user:pass@host:port   (QUOTAGUARDSHIELD_URL / FIXIE_URL also read)
KITE_PROXY_URL=

# ─── Orders ──────────────────────────────────────────────────────────
# LIMIT  = marketable limit at LTP ± LIMIT_BUFFER_PCT (default; works on
#          stock options where market orders are restricted)
# MARKET = market order with mandatory market_protection (-1 = Kite auto)
ORDER_TYPE=LIMIT
LIMIT_BUFFER_PCT=2.0
MARKET_PROTECTION=-1
# unfilled remainder is cancelled after this
ORDER_CONFIRM_SEC=8
ORDER_TAG=zsc_opt
# only if Zerodha assigns you an exchange algo ID
# KITE_ALGO_ID=
# NRML = overnight carry
KITE_PRODUCT=NRML

# ─── Persistence (mount a Railway volume at /app/data) ───────────────
DATA_DIR=/app/data
ACCESS_TOKEN_PATH=/app/data/kite_access_token.txt

# ─── Ladder — % on the UNDERLYING SPOT; match the Pine ladder mirror ──
EXIT_POLL_SEC=5
SL_PCT=3.0
TP_STEP_PCT=4.0
BOOK_PCT=33.0
MAX_BOOKS=2
LADDER_VERBOSE=false
# premium-drop backstop, 0 = off
PREMIUM_SL_PCT=50.0

# ─── Combined premium-P&L locks ──────────────────────────────────────
PROFIT_LOCK_ENABLED=true
PROFIT_LOCK_PCT=30.0
PROFIT_LOCK_COOLDOWN_SEC=1800
LOSS_LOCK_ENABLED=true
LOSS_LOCK_PCT=25.0
LOSS_LOCK_COOLDOWN_SEC=1800

DAILY_CAP_ENABLED=true
DAILY_CAP_PCT=50.0
STREAK_PAUSE_ENABLED=true
STREAK_PAUSE_COUNT=3
STREAK_PAUSE_SEC=3600
SL_LOCKOUT_ENABLED=true
SL_LOCKOUT_SEC=600

# ─── server2 parity ──────────────────────────────────────────────────
MAX_POSITIONS=5
FLAT_ONLY_SETUP_CHECK=true
# opposite entry within N s of the leg = skip (anti-whipsaw)
FLIP_FRESH_GRACE_SEC=15
SELL_RETRY_BACKOFF_SEC=30

RECONCILE_ENABLED=true
RECONCILE_SEC=30
RECONCILE_GRACE_SEC=15
# true = untracked long NRML options on whitelisted names get a ladder
RECONCILE_ADOPT=false
# buy back any SHORT on an option this bot traded
RECONCILE_COVER_SHORTS=true

# NRML carries overnight; true = close all at DAILY_FLATTEN_TIME
DAILY_FLATTEN_ENABLED=false
DAILY_FLATTEN_TIME=15:15
DAILY_FLATTEN_COOLDOWN_SEC=120

# ─── Sizing ──────────────────────────────────────────────────────────
# > 0 = fixed premium budget per trade (overrides EQUITY_PCT)
FIXED_PREMIUM_INR=0
EQUITY_PCT_PER_TRADE=20.0
CASH_BUFFER_INR=100
NUM_LOTS_MIN=1
NUM_LOTS_MAX=100

# ─── Contract selection ──────────────────────────────────────────────
# skip / close contracts within N days of expiry
EXPIRY_SAFETY_DAYS=1
# 0 = ITM-by-one, +1 = ATM, −1 = deeper ITM
STRIKE_OFFSET=0
